# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Real mailbox used to build hidden login emails: username "drex" -> local+drex@gmail.com
# (users never see it; no emails are sent while "Confirm email" is OFF)
VITE_AUTH_EMAIL_BASE=your.name@gmail.com

# Mapbox public token (map tiles, directions, place search)
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Only used by `npm run create-admin` (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
